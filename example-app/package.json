    "expo": "^54.0.1",
    "expo-asset": "~12.0.3",
    "expo-blur": "~15.0.2",
    "expo-constants": "~18.0.3",
    "expo-font": "~14.0.2",
    "expo-haptics": "~15.0.2",
    "expo-image": "~3.0.2",
